FLASK_HOST=0.0.0.0
FLASK_PORT=5040
FLASK_DEBUG=false

# Replace with your actual production domain.
# For local dev only: http://localhost:5040,http://127.0.0.1:5040,https://localhost,http://localhost
CORS_ALLOWED_ORIGINS=https://yourdomain.example.com

SESSION_TTL_SECONDS=7200
TRANSCRIBE_AUTOSTART_WORKER=true

# DATABASE_URL=sqlite:///susi.db

# Hugging Face Token 
# HF_TOKEN="your_huggingface_token_here"

# Rate-limiting storage
REDIS_URL=redis://redis:6379/0

# Database
# SQLite (default — safe out-of-the-box, no extra driver needed).
# Run migrations before first start:
#   cd flask && uv run python -m flask --app transcribe_server.py db upgrade
DATABASE_URL=sqlite:///susi.db

# PostgreSQL, requires psycopg2-binary already listed in pyproject.toml
# PostgreSQL Config
POSTGRES_USER=susi_user
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_-hex_32
POSTGRES_DB=susi

# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT/Auth
# REQUIRED: minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

JWT_COOKIE_SAMESITE=Lax

# Set to true when serving over HTTPS (use a reverse proxy like Nginx in prod).
# JWT_COOKIE_SECURE=false   # dev only
JWT_COOKIE_SECURE=true

# CSRF protection for cookie-based JWT. Automatically enabled when
# JWT_COOKIE_SECURE=true. When enabled, every POST/PUT/DELETE request from the
# frontend must include an X-CSRF-TOKEN header (the frontend already does this).
# Override explicitly if needed:
# JWT_COOKIE_CSRF_PROTECT=true


# Your fully-qualified domain name 
# DOMAIN_NAME=susi.example.org

# API token from your DNS provider's dashboard
# DNS_TOKEN=your-dns-provider-api-token
